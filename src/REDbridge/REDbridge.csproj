<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>REDbridge</RootNamespace>
    <AssemblyName>REDbridge</AssemblyName>
    <Version>0.10.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" Version="2.25.29" />
    <!-- Same version WolvenKit pins, to avoid a mixed set of Microsoft.Extensions assemblies. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.2" />
  </ItemGroup>

  <!-- WolvenKit's headless libraries, from WolvenKit's own NuGet packages (GPL-3.0; source at
       https://github.com/WolvenKit/WolvenKit, the tag of the same version). Dependabot proposes each
       new release by raising WolvenKitVersion, which all four and the DirectXTexNet path below share. -->
  <PropertyGroup>
    <WolvenKitVersion>10.0.0-beta.1</WolvenKitVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WolvenKit.Core" Version="$(WolvenKitVersion)" />
    <PackageReference Include="WolvenKit.RED4" Version="$(WolvenKitVersion)" />
    <PackageReference Include="WolvenKit.Common" Version="$(WolvenKitVersion)" />
    <PackageReference Include="WolvenKit.Modkit" Version="$(WolvenKitVersion)" />
    <!-- Modkit's NAudio.Lame copies libmp3lame.*.dll in its build step, which only runs for a direct reference. -->
    <PackageReference Include="NAudio.Lame" Version="2.1.0" />
    <!-- WolvenKit.Common ships DirectXTexNet.dll as a content file, not a library, so .NET does not list it
         in the app's deps.json and texture conversion fails to load it. A direct reference lists it. -->
    <Reference Include="DirectXTexNet">
      <HintPath>$(NuGetPackageRoot)wolvenkit.common\$(WolvenKitVersion)\contentFiles\any\any\DirectXTexNet.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
